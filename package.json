{
  "name": "pro-liminal",
  "private": true,
  "description": "pro_Liminal: v1（凍結）/ v2（拡張版）/ shared（共通素材）の npm workspaces",
  "workspaces": [
    "shared",
    "v1",
    "v2"
  ],
  "scripts": {
    "dev": "npm run dev -w v1",
    "dev:v1": "npm run dev -w v1",
    "build:v1": "npm run build -w v1",
    "typecheck:v1": "npm run typecheck -w v1",
    "deploy:v1": "npm run deploy:pages -w v1",
    "dev:v2": "npm run dev -w v2",
    "typecheck:v2": "npm run typecheck -w v2",
    "verify:v2": "npm run verify -w v2"
  }
}
